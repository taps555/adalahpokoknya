"use strict";

const prisma = require("../lib/prisma");

const LABOR_KEYWORDS = [
  "mandor",
  "pekerja",
  "tukang",
  "kepala tukang",
  "pembantu tukang",
];
const EQUIPMENT_KEYWORDS = [
  "sewa",
  "excavator",
  "crane",
  "dump truk",
  "dump truck",
  "flat bed truck",
  "flat deck truck",
  "water truck",
  "water tanker",
  "vibrator",
  "mixer",
  "grader",
  "roller",
  "stemper",
  "theodolite",
  "welding set",
  "tire roller",
];

/**
 * Baris di daftar "HARGA SATUAN BAHAN, UPAH DAN ALAT" tidak selalu eksplisit
 * bertipe bahan — ada juga upah harian (Mandor/OH) dan sewa alat. Kita tebak
 * tipenya dari nama/satuan. Untuk item AHSP (di dalam section A/B/C) tipenya
 * sudah pasti dari section-nya, jadi heuristik ini hanya dipakai untuk
 * daftar harga dasar yang berdiri sendiri.
 */
function classifyResourceType(name, unit) {
  const n = name.toLowerCase().replace(/\s+/g, " "); // <- normalize multi-spasi jadi 1
  const u = (unit || "").toLowerCase();
  if (
    u === "oh" ||
    u === "orang/hari" ||
    LABOR_KEYWORDS.some((k) => n.includes(k))
  ) {
    return "UPAH";
  }
  if (EQUIPMENT_KEYWORDS.some((k) => n.includes(k))) {
    return "ALAT";
  }
  return "BAHAN";
}

function priceItemKey(type, name, unit) {
  return `${type}|${name.trim().toLowerCase()}|${unit.trim().toLowerCase()}`;
}

const SECTION_TYPE = { labor: "UPAH", material: "BAHAN", equipment: "ALAT" };

/**
 * Upsert satu PriceItem, dan taruh id-nya ke dalam `cache` (Map) supaya
 * dipakai lagi saat menyusun JobComponent tanpa query ulang.
 */
async function upsertPriceItem(
  cache,
  { type, name, unit, price, period, discipline, grade, filename, batchId },
) {
  const key = priceItemKey(type, name, unit) + `|${discipline}|${grade}`;
  if (cache.has(key)) return cache.get(key);

  const rec = await prisma.priceItem.upsert({
    where: { uniq_price_item: { type, name, unit, period, discipline, grade } },
    update: { price, source: filename, batchId },
    create: {
      type,
      name,
      unit,
      price,
      period,
      discipline,
      grade,
      source: filename,
      batchId,
    },
  });
  cache.set(key, rec.id);
  return rec.id;
}

/**
 * @param {object} params
 * @param {{materials:Array, jobs:Array, issues:Array}} params.parsed hasil dari parser
 * @param {number} params.period tahun berlaku HSPK, mis. 2026
 * @param {string} params.filename nama file asal (untuk audit)
 * @param {'PDF'|'XLSX'|'CSV'} params.fileKind
 */
async function importParsedData({
  parsed,
  period,
  discipline,
  grade,
  filename,
  fileKind,
}) {
  const batch = await prisma.uploadBatch.create({
    data: { filename, fileKind, period, status: "PROCESSING" },
  });

  const priceItemCache = new Map();

  try {
    for (const m of parsed.materials) {
      if (m.price == null) continue;
      const type = classifyResourceType(m.name, m.unit);
      await upsertPriceItem(priceItemCache, {
        type,
        name: m.name,
        unit: m.unit,
        price: m.price,
        period,
        discipline,
        grade,
        filename,
        batchId: batch.id,
      });
    }

    for (const job of parsed.jobs) {
      for (const sectionKey of Object.keys(SECTION_TYPE)) {
        const type = SECTION_TYPE[sectionKey];
        for (const item of job[sectionKey]) {
          if (item.price == null) continue;
          await upsertPriceItem(priceItemCache, {
            type,
            name: item.name,
            unit: item.unit,
            price: item.price,
            period,
            discipline,
            grade,
            filename,
            batchId: batch.id,
          });
        }
      }
    }

    let jobTypeCount = 0;
    for (const job of parsed.jobs) {
      const hasComponents =
        job.labor.length > 0 ||
        job.material.length > 0 ||
        job.equipment.length > 0;
      if (!hasComponents) continue;

      const jt = await prisma.jobType.upsert({
        where: {
          uniq_job_type: {
            name: job.name,
            paymentUnit: job.paymentUnit,
            period,
            discipline,
            grade,
          },
        },
        update: {
          category: job.category || undefined,
          reference: job.reference || undefined,
          source: filename,
          batch: { connect: { id: batch.id } },
          needsReview: !!job.needsReview,
          overhead: job.overhead,
        },
        create: {
          name: job.name,
          paymentUnit: job.paymentUnit,
          category: job.category,
          reference: job.reference,
          period,
          discipline,
          grade,
          source: filename,
          batch: { connect: { id: batch.id } },
          needsReview: !!job.needsReview,
          overhead: job.overhead,
        },
      });

      await prisma.jobComponent.deleteMany({ where: { jobTypeId: jt.id } });

      const componentRows = [];
      for (const sectionKey of Object.keys(SECTION_TYPE)) {
        const type = SECTION_TYPE[sectionKey];
        for (const item of job[sectionKey]) {
          if (item.price == null || item.coefficient == null) continue;
          const priceItemId = priceItemCache.get(
            priceItemKey(type, item.name, item.unit) +
              `|${discipline}|${grade}`,
          );
          if (!priceItemId) continue;
          componentRows.push({
            jobTypeId: jt.id,
            priceItemId,
            section: type,
            coefficient: item.coefficient,
          });
        }
      }
      if (componentRows.length > 0) {
        await prisma.jobComponent.createMany({ data: componentRows });
      }
      jobTypeCount++;
    }

    if (parsed.issues.length > 0) {
      await prisma.uploadIssue.createMany({
        data: parsed.issues.map((i) => ({
          batchId: batch.id,
          context: i.context,
          rawLine: i.rawLine.slice(0, 2000),
          reason: i.reason,
        })),
      });
    }

    const status = parsed.issues.length > 0 ? "PARTIAL" : "SUCCESS";
    await prisma.uploadBatch.update({
      where: { id: batch.id },
      data: {
        status,
        priceItemCount: priceItemCache.size,
        jobTypeCount,
        finishedAt: new Date(),
      },
    });

    return {
      batchId: batch.id,
      status,
      priceItemCount: priceItemCache.size,
      jobTypeCount,
      issueCount: parsed.issues.length,
    };
  } catch (err) {
    await prisma.uploadBatch.update({
      where: { id: batch.id },
      data: {
        status: "FAILED",
        errorMessage: String(err.message || err),
        finishedAt: new Date(),
      },
    });
    throw err;
  }
}

module.exports = { importParsedData, classifyResourceType };
</file>

<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  BAHAN // material
  UPAH  // tenaga kerja / labor
  ALAT  // peralatan / equipment
}

enum UploadStatus {
  PROCESSING
  SUCCESS
  PARTIAL // berhasil sebagian, ada baris yang gagal di-parse (lihat UploadIssue)
  FAILED
}

enum Discipline {
  SIPIL
  INTERIOR
}

enum FileKind {
  PDF
  XLSX
  CSV
}

/// Daftar harga satuan dasar: bahan, upah (tenaga kerja), dan alat.
/// Ini adalah bagian "HARGA SATUAN BAHAN, UPAH DAN ALAT" di dokumen HSPK.
model PriceItem {
  id        String       @id @default(cuid())
  type      ResourceType
  name      String
  unit      String
  price     Decimal      @db.Decimal(18, 4)
  discipline Discipline?
  grade      String?      // "A" | "B" | "C"
  period    Int // tahun berlaku, misal 2026
  source    String? // nama file asal
  batchId   String?
  batch     UploadBatch? @relation(fields: [batchId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  usages JobComponent[]

  // satu nama+satuan+tipe hanya boleh punya 1 harga per periode
  @@unique([type, name, unit, period, discipline, grade], name: "uniq_price_item")
  @@index([period])
  @@index([name])
}

/// Satu jenis pekerjaan AHSP (mis. "Pemasangan 1 m2 Dinding Bata Merah").
/// Koefisien tenaga kerja/bahan/alat-nya ada di JobComponent.
model JobType {
  id          String       @id @default(cuid())
  name        String // "Jenis Pekerjaan"
  paymentUnit String // "Satuan Pembayaran", misal m2, m3, kg, buah
  category    String? // "A. PEKERJAAN PERSIAPAN", dst
  reference   String? // referensi SNI / Permen PUPR
  period      Int
  source      String?
  batchId     String?
  discipline Discipline?
  
  grade      String?
  batch       UploadBatch? @relation(fields: [batchId], references: [id])
  overhead Float? // Menambahkan kolom overhead, boleh kosong (null)

  bvItems BvItem[]
  
  needsReview Boolean      @default(false) // true kalau ada baris yang gagal di-parse saat import
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  components JobComponent[]

  @@unique([name, paymentUnit, period, discipline, grade], name: "uniq_job_type")
  @@index([period])
  @@index([category])
}

/// Baris koefisien pada AHSP: berapa banyak PriceItem tertentu dibutuhkan
/// untuk 1 satuan pekerjaan. Contoh: Semen PC 50 Kg, koefisien 6.18 zak.
model JobComponent {
  id          String       @id @default(cuid())
  jobTypeId   String
  jobType     JobType      @relation(fields: [jobTypeId], references: [id], onDelete: Cascade)
  priceItemId String
  priceItem   PriceItem    @relation(fields: [priceItemId], references: [id])
  section     ResourceType // A = UPAH, B = BAHAN, C = ALAT
  coefficient Decimal      @db.Decimal(14, 6)

  @@index([jobTypeId])
  @@index([priceItemId])
}

/// Riwayat setiap file yang di-upload (PDF/Excel) beserta ringkasan hasil
/// import-nya. Berguna untuk audit trail & untuk melihat baris yang gagal.
model UploadBatch {
  id             String       @id @default(cuid())
  filename       String
  fileKind       FileKind
  period         Int
  status         UploadStatus @default(PROCESSING)
  priceItemCount Int          @default(0)
  jobTypeCount   Int          @default(0)
  errorMessage   String?
  createdAt      DateTime     @default(now())
  finishedAt     DateTime?

  priceItems PriceItem[]
  jobTypes   JobType[]
  issues     UploadIssue[]
}

/// Baris mentah yang gagal di-parse otomatis (harga #REF!, format aneh, dll)
/// supaya bisa direview & dikoreksi manual lewat UI/endpoint, bukan hilang begitu saja.
model UploadIssue {
  id        String      @id @default(cuid())
  batchId   String
  batch     UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  context   String? // nama job / section saat error terjadi, kalau ada
  rawLine   String // teks baris asli
  reason    String // kenapa gagal di-parse
  resolved  Boolean     @default(false)
  createdAt DateTime    @default(now())
}

// =========================================================
// Tambahan: Client & Project
// Bagian "Input Data Dasar" + "Pemilihan Data HSPK/AHSP"
// =========================================================

/// Client/pemilik proyek. Satu client bisa punya banyak proyek.
model Client {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects Project[]

  @@index([name])
}
model Project {
  id         String   @id @default(cuid())
  name       String
  location   String
  hspkPeriod Int
  discipline Discipline   // <-- TAMBAH, wajib diisi
  grade      String?      // <-- TAMBAH
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  rabItems   RabItem[]
  bvItems BvItem[]

  rabGroups RabGroup[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@index([hspkPeriod])

}

model RabItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  paymentUnit String
  category    String?
  reference   String?
  overhead    Float?
  discipline  Discipline?   // <-- TAMBAH
  grade       String?       // <-- TAMBAH (opsional, biar lengkap)

  volume         Decimal  @db.Decimal(14, 4)

  rapUnitPrice   Decimal  @db.Decimal(18, 4)  // otomatis, dari kalkulasi HSPK
  rapTotalPrice  Decimal  @db.Decimal(18, 4)  // rapUnitPrice * volume

  rabUnitPrice   Decimal  @db.Decimal(18, 4)  // MANUAL, diisi estimator
  rabTotalPrice  Decimal  @db.Decimal(18, 4)  // rabUnitPrice * volume

  sourceJobTypeId String?
  groupId         String?
  group           RabGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  bvItem BvItem? 

  components RabItemComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model RabItemComponent {
  id        String       @id @default(cuid())
  rabItemId String
  rabItem   RabItem      @relation(fields: [rabItemId], references: [id], onDelete: Cascade)

  name        String
  unit        String
  section     ResourceType
  coefficient Decimal      @db.Decimal(14, 6)
  unitPrice   Decimal      @db.Decimal(18, 4)
  lineTotal   Decimal      @db.Decimal(18, 4)
}


model RabGroup {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String   // "PERSIAPAN LAPANGAN" / "PEKERJAAN PERSIAPAN"
  reference String?  // "1" / "1.1" dst, opsional buat penomoran otomatis
  order     Int      @default(0) // urutan tampil

  parentId  String?
  parent    RabGroup?  @relation("GroupChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  RabGroup[] @relation("GroupChildren")

  items     RabItem[]

  bvItems BvItem[]

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([parentId])
}

model DisciplineGrade {
  id         String     @id @default(cuid())
  discipline Discipline
  grade      String
  order      Int        @default(0)

  @@unique([discipline, grade])
}

model BvItem {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupId   String?
  group     RabGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  parentBvItemId String?
  parentBvItem   BvItem?  @relation("BvItemChildren", fields: [parentBvItemId], references: [id], onDelete: Cascade)
  children       BvItem[] @relation("BvItemChildren")

  isHeaderOnly Boolean @default(false)   // true = cuma label, gak ada volume/breakdown

  sourceJobTypeId String?
  sourceJobType   JobType? @relation(fields: [sourceJobTypeId], references: [id])

  name        String?
  keterangan  String?
  paymentUnit String?

  totalVolume Decimal @db.Decimal(14, 4)

  ecommerceLink   String?
  linkedRabItemId String?  @unique
  linkedRabItem   RabItem? @relation(fields: [linkedRabItemId], references: [id], onDelete: SetNull)

  breakdowns BvBreakdown[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([groupId])
  @@index([parentBvItemId])
}

model BvBreakdown {
  id       String @id @default(cuid())
  bvItemId String
  bvItem   BvItem @relation(fields: [bvItemId], references: [id], onDelete: Cascade)

  keterangan String?
  panjang    Decimal? @db.Decimal(10, 4)
  lebar      Decimal? @db.Decimal(10, 4)
  tinggi     Decimal? @db.Decimal(10, 4)
  luas       Decimal? @db.Decimal(10, 4)
  keliling   Decimal? @db.Decimal(10, 4)
  diameter   Decimal? @db.Decimal(10, 4)
  berat      Decimal? @db.Decimal(10, 4)
  jumlahSisi Decimal? @db.Decimal(10, 4)
  jumlahBh   Decimal? @db.Decimal(10, 4)
  waste      Decimal? @db.Decimal(6, 4) @default(0)

  subTotal Decimal @db.Decimal(14, 4)

  @@index([bvItemId])
}
