# Connection string PostgreSQL kamu
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testing?schema=public"

# Port server Express
PORT=4000

# Batas ukuran file upload (MB)
MAX_UPLOAD_MB=15

# Fitur approval/baseline BV/RAB (ajukan review, setujui, minta revisi).
# Dimatikan default; set "true" untuk mengaktifkan kembali.
BV_RAB_APPROVAL_ENABLED=false
